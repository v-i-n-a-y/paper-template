# Paper build configuration — read by Makefile via -include .env
# All values here override Makefile defaults.
# Use 'make config' to view all values, 'make set KEY=... VALUE=...' to edit.

# Output stem for PDF and drafts; source is always main.tex.
PAPER_NAME=main

# Directory for LaTeX build artefacts (.aux, .log, etc.).
BUILD_DIR=build

# Output directory for archived draft PDFs.
DRAFTS_DIR=drafts

# Version file (hidden; managed by make draft / bump / set-major / set-minor).
VERSION_FILE=.version

# Number of parallel Make jobs. Set to your CPU core count for multi-doc builds.
JOBS=1

# Set to true to delete build artefacts automatically after each build.
AUTOCLEAN=false

# Space-separated list of extensions removed by 'make clean'.
# Extend this list if a package you use litters extra files.
CLEAN_EXTENSIONS=aux log out bbl blg synctex.gz toc spl fls fdb_latexmk
